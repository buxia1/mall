# 本地开发配置模板。
#
# 复制为同目录下的 application-dev.yml 后按本机环境填写真实值。
# application-dev.yml 已被 .gitignore 忽略，密码和密钥不会进入版本库。
#
# 首次准备数据库：
#   mysql -h 127.0.0.1 -P 3307 -u root -p -e "CREATE DATABASE mall DEFAULT CHARACTER SET utf8mb4;"
#   mysql -h 127.0.0.1 -P 3307 -u root -p mall < sql/auth-schema.sql
#   mysql -h 127.0.0.1 -P 3307 -u root -p mall < sql/auth-seed.sql

spring:
  datasource:
    url: "jdbc:mysql://localhost:3307/mall?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true"
    username: mall
    password: change-me
  data:
    redis:
      host: localhost
      port: 6379
      password: change-me

mall:
  security:
    jwt:
      # HS256 要求密钥至少 32 字节；用随机串，不要复用示例值。
      secret: change-me-to-a-random-secret-of-at-least-32-bytes
